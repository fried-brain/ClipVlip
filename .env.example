# Optional AI moment ranking. Without these, local transcript heuristics are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CLIPVLIP_LLM_MODEL=gpt-4o-mini

# Local Whisper settings: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Persistent storage directory
CLIPVLIP_DATA=./data

# Supabase persistence and private media storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SOURCE_BUCKET=clipvlip-sources
SUPABASE_OUTPUT_BUCKET=clipvlip-outputs
